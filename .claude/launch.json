{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3010,
      "autoPort": true
    },
    {
      "name": "prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "dev-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_DIST_DIR=.next-dev-alt",
        "pnpm",
        "exec",
        "next",
        "dev",
        "--turbopack",
        "--port",
        "3011"
      ],
      "port": 3011
    }
  ]
}
